---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeBackground from '../components/ThreeBackground.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="AstroCademiX | Data-Driven Discovery" description="AstroCademiX explores astrophysics, interpretable machine learning, and data-driven discovery.">
  <ThreeBackground />
  <Navigation />
  <Hero />

  <main>
    <section class="recent-posts">
      <div class="container">
        <h2 class="section-title">Curiosity, code, and the cosmos.</h2>
        <p class="section-subtitle">Our members explore astrophysics, interpretable machine learning, simulation, and data-driven discovery.</p>
        <div class="focus-grid">
          <article><span>01</span><h3>Astrophysics</h3><p>Questions about the universe, explored through observation and theory.</p></article>
          <article><span>02</span><h3>Data-driven methods</h3><p>Computational approaches that turn complex data into insight.</p></article>
          <article><span>03</span><h3>Open collaboration</h3><p>Projects and ideas shared across disciplines.</p></article>
        </div>
        <div class="view-all"><a href={`${base}members`} class="btn btn-secondary">Meet our members →</a><a href={`${base}about`} class="btn btn-secondary">About the club →</a></div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .recent-posts {
    padding: 6rem 2rem 8rem;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-dim);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .view-all { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 2.5rem; }
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .focus-grid article { background: rgba(30,41,59,.7); border: 1px solid var(--color-border); border-radius: 1rem; padding: 2rem; }
  .focus-grid span { color: #7dd3fc; font-size: .8rem; }
  .focus-grid h3 { margin: 1rem 0 .5rem; }
  .focus-grid p { color: var(--color-text-dim); line-height: 1.7; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    font-family: var(--font-body);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: rgba(59, 130, 246, 0.1);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .btn-secondary svg {
    transition: transform 0.2s ease;
  }

  .btn-secondary:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .recent-posts {
      padding: 4rem 1.5rem 6rem;
    }

    .focus-grid { grid-template-columns: 1fr; }
  }
</style>
